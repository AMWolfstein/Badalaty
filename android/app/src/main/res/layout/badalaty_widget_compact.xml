<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_system" android:orientation="vertical" android:padding="9dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/widget_mark" android:layout_width="23dp" android:layout_height="23dp"
            android:background="@drawable/widget_mark_system" android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/widget_mark_icon" android:layout_width="15dp" android:layout_height="15dp"
                android:layout_gravity="center" android:src="@drawable/widget_ic_wallet" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:ellipsize="end" android:maxLines="1"
            android:includeFontPadding="false" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:layout_marginTop="3dp" android:layout_marginBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_metric" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:ellipsize="end" android:maxLines="1"
                android:text="@string/widget_today_amount" android:textSize="11sp" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="bottom" android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="1dp" android:includeFontPadding="false"
                    android:maxLines="1" android:ellipsize="end"
                    android:textSize="30sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_currency" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:layout_marginBottom="2dp" android:includeFontPadding="false"
                    android:maxLines="1" android:text="@string/widget_egp" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_add" android:layout_width="match_parent"
        android:layout_height="36dp" android:background="@drawable/widget_primary_system"
        android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="3dp">
        <ImageView
            android:id="@+id/widget_add_icon" android:layout_width="13dp" android:layout_height="13dp"
            android:importantForAccessibility="no" android:src="@drawable/widget_ic_add" />
        <TextView
            android:id="@+id/widget_add_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="3dp" android:ellipsize="end" android:maxLines="1"
            android:includeFontPadding="false" android:text="@string/widget_add"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
